# Copy to ~/.config/secure-record/notify.env and fill in (git-ignored).
# Sourced by bg-watchdog.sh for the Telegram notifications.
# Create a bot with @BotFather; get your chat id from @userinfobot
# or add the bot to a group and read the updates API.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Where the production instance lives (config.yaml, keys/, data/)
APP_DIR="$HOME/apps/sealed-inbox"
# Port the dashboard listens on (must match config.yaml dashboard.port)
PORT=8086

# One-tap v6 link composition (used by make_v6_link.py on tunnel change):
# FORM_URL  where the sender page is hosted (stable GitHub Pages URL)
# RELAY_URL the form-relay endpoint the sender page submits to
FORM_URL="https://<owner>.github.io/secure-relay-fast-v6.html"
RELAY_URL=
